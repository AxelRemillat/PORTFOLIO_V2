# Claude Code — augmente la limite de tokens en sortie
CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# OpenAI (server-side uniquement — ne jamais exposer côté client)
OPENAI_API_KEY=sk-...

# Supabase — projet dédié portfolio
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Umami analytics (privacy-first, cookieless — variables publiques, dashboard privé sur Umami)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Resend — envoi du formulaire de contact (compte gratuit sur resend.com).
# Expéditeur : axel@axelremillat.com (domaine à vérifier dans Resend, voir README) ;
# tant qu'il ne l'est pas, repli automatique sur onboarding@resend.dev.
RESEND_API_KEY=re_XXXXXXXXX

# n8n — démo publique de tri d'email (case study /preuves/n8n)
# URL du webhook n8n (elestio) qui exécute le tri
N8N_EMAIL_TRIAGE_WEBHOOK_URL=
# Secret partagé, envoyé en header x-demo-secret (doit matcher côté n8n)
N8N_DEMO_SECRET=
# Kill-switch de la démo : "true" pour activer, sinon désactivée (défaut true)
DEMO_EMAIL_TRIAGE_ENABLED=true

# n8n — démo compte rendu de réunion (workflow #2 : texte OU audio, même x-demo-secret)
# URL du webhook n8n qui transcrit (Whisper) + résume
N8N_MEETING_WEBHOOK_URL=
# Kill-switch de la démo compte rendu : "true" pour activer
DEMO_MEETING_ENABLED=true

# n8n — démo nettoyage de données CSV (workflow #3, multipart, même x-demo-secret)
N8N_DATACLEAN_WEBHOOK_URL=
DEMO_DATACLEAN_ENABLED=true

# n8n — démo extraction de facture (workflow #4, image→base64 JSON, même x-demo-secret)
N8N_INVOICE_WEBHOOK_URL=
DEMO_INVOICE_ENABLED=true

# n8n — démo assistant SAV RAG (workflow #5, JSON { question }, même x-demo-secret)
N8N_SAV_WEBHOOK_URL=
DEMO_SAV_ENABLED=true

# Agent commercial autonome (projet #4, 100% code + OpenAI, pas de n8n) — kill-switch
DEMO_AGENT_ENABLED=true

# Kill-switches VEGA (chat + voix) — OPT-OUT : actifs par défaut, ne
# renseigner qu'en cas d'abus pour COUPER instantanément (mettre la valeur à "false").
# DEMO_VEGA_ENABLED=false   # coupe le chat VEGA (/api/chat)
# DEMO_TTS_ENABLED=false    # coupe la voix ElevenLabs/OpenAI (/api/tts) → voix navigateur

# ElevenLabs (voix VEGA — optionnel ; sans clé, repli sur OpenAI TTS puis navigateur)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Rate-limit des démos (Upstash Redis REST — optionnel). Absent → fallback mémoire best-effort.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
